{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "db/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "worker/**/*.ts",
    "types/**/*.d.ts",
    "auth.ts",
    "proxy.ts"
  ],
  "exclude": ["node_modules", ".next", "tests", "e2e"]
}
