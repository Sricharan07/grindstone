# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=grindstone
POSTGRES_PASSWORD=
POSTGRES_DB=grindstone
# Use the same password above, URL-encoded when it contains reserved characters.
DATABASE_URL=

# ── SQL practice sandbox (separate, read-only, disposable) ────────────────
SQLSANDBOX_URL=postgres://sandbox_ro:sandbox@localhost:5434/sandbox

# ── Redis (rate limits + job queue) ───────────────────────────────────────
REDIS_URL=redis://localhost:6381

# ── Judge ─────────────────────────────────────────────────────────────────
# docker-run for direct local development; the hosted Compose profile forces Piston.
JUDGE_ADAPTER=docker-run
PISTON_URL=http://localhost:2000
JUDGE_TIMEOUT_MS=8000
JUDGE_MEMORY_MB=256
JUDGE_PIDS_LIMIT=64
JUDGE_RUNS_PER_MINUTE=30

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public HTTPS URL on the Windows host. Not required while AUTH_REQUIRED=false.
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated. Only these emails ever get a user row.
ALLOWED_EMAILS=
# Subset of ALLOWED_EMAILS allowed to queue paid content generation.
ADMIN_EMAILS=
# Keep false for local solo development. Set true on the Windows host.
AUTH_REQUIRED=false

# ── AI ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_GENERATION_MODEL=claude-sonnet-5
AI_CRITIC_MODEL=claude-opus-5
# Hard cap. The content worker stops dead when the month's spend hits this.
AI_MONTHLY_CAP_USD=40
# Per-user cap for hints, reviews, teach-back and mock debriefs.
AI_USER_MONTHLY_CAP_USD=5
# Override when provider pricing changes; used for preflight and usage records.
AI_GENERATION_INPUT_USD_PER_MILLION=3
AI_GENERATION_OUTPUT_USD_PER_MILLION=15
AI_CRITIC_INPUT_USD_PER_MILLION=15
AI_CRITIC_OUTPUT_USD_PER_MILLION=75

# ── Tunnel (Windows host only) ────────────────────────────────────────────
TUNNEL_TOKEN=
